# Copy this file to .env and replace the placeholders with your own values.
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# Singapore general endpoint. A workspace-dedicated endpoint also works only
# when both its real Workspace ID and a key from that workspace are supplied.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Native endpoint for text_type=query and query instructions. If omitted, it is
# inferred from QWEN_BASE_URL when that URL ends with /compatible-mode/v1.
QWEN_DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1

QWEN_MODEL=qwen-plus

# Text embedding is used for dense retrieval experiments.
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIM=256
QWEN_API_TIMEOUT_SECONDS=30
QWEN_API_MAX_RETRIES=3
QWEN_EMBEDDING_BATCH_SIZE=10
QWEN_EMBEDDING_MAX_CHARS=12000
QWEN_QUERY_INSTRUCTION=Given the current shopping request, retrieve catalog products that best match the requested product type and disclosed constraints. Prioritize the product type and hard requirements; treat soft preferences as secondary signals.
